# ========================================
# Stellar Field Buddy - Variáveis de Ambiente
# ========================================
# Copie este arquivo para .env e preencha os valores.

# --- Banco de dados ---
# URL do PostgreSQL (docker-compose preenche automaticamente)
DATABASE_URL=postgres://app:app@postgres:5432/app

# --- Segurança ---
# Chave para criptografar dados sensíveis no config.json (MUDE EM PRODUCAO!)
ENCRYPTION_KEY=stellar-change-me-in-production

# --- Servidor ---
NODE_ENV=production
PORT=3000
